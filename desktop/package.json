{
  "name": "tcs-desktop",
  "productName": "TCS",
  "version": "1.0.0",
  "description": "TCS — Total Care System (맥 앱)",
  "main": "main.js",
  "private": true,
  "author": "TCS",
  "scripts": {
    "start": "electron .",
    "dmg": "electron-builder --mac dmg --arm64",
    "dmg:intel": "electron-builder --mac dmg --x64",
    "dmg:all": "electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.koreayjk.tcs.desktop",
    "productName": "TCS",
    "copyright": "© 2026 TCS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "TCS",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koreayjk/imessenger.git"
  }
}
