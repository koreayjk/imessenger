{
  "appId": "io.github.koreayjk.tcs",
  "appName": "TCS",
  "webDir": "www",
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#F8F3EA"
  },
  "server": {
    "iosScheme": "capacitor"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1200,
      "backgroundColor": "#1d3a5f",
      "showSpinner": false
    }
  }
}
